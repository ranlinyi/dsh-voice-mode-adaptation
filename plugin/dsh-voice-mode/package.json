{
  "name": "dsh-voice-mode-adaptation",
  "description": "Read-aloud plugin for DeepSeek Harness (speech output only, no voice input): one Read button per assistant reply plus an auto read-aloud master switch that reads every new reply and interrupts the previous unfinished one; Edge TTS or local VITS / Kokoro; optional speech adaptation station turns formulas/tables/code into spoken scripts while screen Markdown stays intact. · DSH 纯语音朗读插件（只朗读、无语音输入）：每条 AI 回复一个朗读键 + 朗读总开关（每轮新回复自动朗读，新回复打断上一条）；Edge / 本地 VITS / Kokoro；可选语音改编站（公式/表格/代码口播稿，屏幕 Markdown 完整保留）。",
  "version": "0.9.0-tts-only.1",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranlinyi/dsh-voice-mode-adaptation.git"
  },
  "homepage": "https://github.com/ranlinyi/dsh-voice-mode-adaptation#readme",
  "bugs": {
    "url": "https://github.com/ranlinyi/dsh-voice-mode-adaptation/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/tts-vits-worker.cjs",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/architecture.svg",
    "assets/demo.gif",
    "scripts/prefetch.mjs",
    "scripts/list-voices.mjs",
    "scripts/verify.mjs",
    "scripts/check-anchors.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "node test/segmenter.test.mjs && node test/block-router.test.mjs && node test/math.test.mjs && node test/azure-ssml.test.mjs && node test/rewriter.test.mjs && node test/speech-adapter.test.mjs && node test/download.test.mjs && node test/verify-client.mjs",
    "verify:client": "node test/verify-client.mjs",
    "prefetch": "node scripts/prefetch.mjs",
    "list-voices": "node scripts/list-voices.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit",
    "check:anchors": "node scripts/check-anchors.mjs",
    "typecheck:dual": "bash scripts/typecheck-dual.sh",
    "smoke:runtime": "bash scripts/smoke-runtime.sh",
    "verify:dual": "bash scripts/verify-dual.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "mdast-util-to-string": "^4.0.0",
    "msedge-tts": "^2.0.7",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sherpa-onnx": "^1.13.6",
    "sherpa-onnx-node": "1.13.6",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright-core": "1.62.1",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "voice",
    "speech",
    "tts",
    "read-aloud",
    "msedge-tts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
